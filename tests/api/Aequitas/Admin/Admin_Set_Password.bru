meta {
  name: Admin Set Password
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/admin/users/{{test_user_id}}/set_password/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

body:json {
  {
    "new_password": "NewAdminPassword123!"
  }
}

script:pre-request {
  // We need to login as an admin first. For this test, we can assume the setup script runs or just do a basic check.
}
