meta {
  name: 2. Setup Insurance
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/settlement/insurances/
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.body.results && res.body.results.length > 0) {
    bru.setVar("ins_id", res.body.results[0].id);
  } else {
    bru.setVar("ins_id", null);
  }
}

assert {
  res.status: eq 200
}