meta {
  name: 2. Setup Insurance
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/settlement/insurances/
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

vars:post-response {
  ins_id: res.body.results[0].id
}

assert {
  res.status: eq 200
  res.body.results.length: gt 0
}