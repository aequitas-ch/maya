meta {
  name: 08_Add_Status_Invalid
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/settlement/approvals/{{approval_id}}/add_status/
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "status": "invalid_status",
    "date": "2023-10-27"
  }
}

assert {
  res.status: eq 400
}
