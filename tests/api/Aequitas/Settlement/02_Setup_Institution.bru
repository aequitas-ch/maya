meta {
  name: 1. Setup Institution
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/settlement/institutions/
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

vars:post-response {
  inst_id: res.body[0].id
}

assert {
  res.status: eq 200
  res.body.length: gt 0
}