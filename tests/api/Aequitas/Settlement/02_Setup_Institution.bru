meta {
  name: 1. Setup Institution
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/settlement/institutions/
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

script:post-response {
  if (res.body.results && res.body.results.length > 0) {
    bru.setVar("inst_id", res.body.results[0].id);
  } else {
    bru.setVar("inst_id", null);
  }
}

assert {
  res.status: eq 200
}