meta {
  name: 01_Auth_Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/token/
  body: json
  auth: none
}

body:json {
  {
    "username": "{{test_username}}",
    "password": "{{test_password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("access_token", res.body.access);
    bru.setVar("refresh_token", res.body.refresh);
  }
}
