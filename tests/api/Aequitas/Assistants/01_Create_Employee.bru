meta {
  name: Create Employee
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/assistants/employees/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "first_name": "Hans",
    "last_name": "Muster",
    "ahv_number": "756.1234.5678.90",
    "address": "Teststr 1",
    "city": "Zürich",
    "zip_code": "8000",
    "type": "IV_ASSISTANCE"
  }
}

vars:post-response {
  employee_id: res.body.id
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response has id", function() {
    expect(res.getBody().id).to.be.a('string');
  });
}
