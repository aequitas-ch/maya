meta {
  name: Create Contract
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/assistants/contracts/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "employee": "{{employee_id}}",
    "hourly_wage": "35.50",
    "start_date": "2023-01-01",
    "probation_period_months": 3
  }
}

vars:post-response {
  contract_id: res.body.id
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
