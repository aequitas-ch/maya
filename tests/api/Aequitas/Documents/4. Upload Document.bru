meta {
  name: Upload Document
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/documents/documents/
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:multipart-form {
  name: Test Document
  description: This is a test
  dependent: {{doc_dependent_id}}
  file: @file(Documents/test_doc.txt)
}

vars:post-response {
  doc_id: res.body.id
}

assert {
  res.status: eq 201
  res.body.name: eq Test Document
}
