meta {
  name: 7. Get Health Records Pagination
  type: http
  seq: 7
}

get {
  url: {{base_url}}/api/health/records/?limit=2&offset=0
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.count: isNumber
  res.body.results: isDefined
}
