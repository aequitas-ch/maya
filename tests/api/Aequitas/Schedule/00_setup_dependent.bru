meta {
  name: setup_dependent
  type: http
  seq: 0
}

post {
  url: {{base_url}}/api/dependents/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "first_name": "Bruno",
    "last_name": "Test",
    "ahv_number": "756.1234.5678.90",
    "address": "Teststrasse 1",
    "city": "Zürich",
    "postal_code": "8000",
    "main_diagnosis": "Test"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("dependent_id", res.body.id);
  }
}

assert {
  res.status: eq 201
}
