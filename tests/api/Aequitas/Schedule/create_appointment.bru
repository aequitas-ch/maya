meta {
  name: create_appointment
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/schedule/appointments/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "dependent": {{dependent_id}},
    "title": "Bruno Test Appointment",
    "start_date": "2026-06-15",
    "start_time": "10:00",
    "end_time": "11:00",
    "institutions": []
  }
}

assert {
  res.status: eq 201
  res.body.title: eq "Bruno Test Appointment"
}
